# Default modifier key (Mod4 is the Super/Windows key)
set $mod Mod4

# Apps
set $term kitty
set $menu noctalia msg panel-toggle launcher
set $browser $BROWSER

# ─── Typography & Window Titles ───
font pango:Maple Mono NF 10
title_align center
titlebar_border_thickness 0

# Định dạng tiêu đề: <b>App ID/Class (In đậm)</b> - <i>Tiêu đề (In nghiêng)</i>
for_window [app_id=".*"] title_format "<b>%app_id</b>  <i>%title</i>"
for_window [class=".*"] title_format "<b>%class</b>  <i>%title</i>"

# ─── Dynamic Window Icons ───
for_window [app_id="(?i)kitty"] title_format "󰄛 <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)zen.*"] title_format "󰈹 <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)thorium.*|chromium|chrome"] title_format " <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)firefox.*"] title_format "󰈹 <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)yazi"] title_format " <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)nvim|neovim"] title_format " <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)code|vscodium"] title_format "󰨞 <b>%app_id</b>  <i>%title</i>"
for_window [class="(?i)vesktop|discord"] title_format " <b>%class</b>  <i>%title</i>"
for_window [app_id="(?i)gpu-screen-recorder|com\.dec05eba\.gpu_screen_recorder"] title_format " <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)telegram.*|org\.telegram\.desktop"] title_format " <b>%app_id</b>  <i>%title</i>"
for_window [class="(?i)jetbrains-.*"] title_format " <b>%class</b>  <i>%title</i>"
for_window [class="(?i)stremio"] title_format "󰎁 <b>%class</b>  <i>%title</i>"
for_window [app_id="(?i)mpv"] title_format " <b>%app_id</b>  <i>%title</i>"
for_window [app_id="(?i)org.gnome.Nautilus"] title_format " <b>%app_id</b>  <i>%title</i>"

# ─── Window Colors (Noctalia Palette) ───
include ~/.config/sway/noctalia

# Ghi đè lại cách phối màu để thanh tiêu đề và viền đồng bộ thành 1 khối rắn
# class                 border    backgr.   text                indicator  child_border
client.focused          $primary  $primary  $on_primary         $primary   $primary
client.focused_inactive $surface  $surface  $on_surface         $surface   $surface
client.unfocused        $surface  $surface  $on_surface_variant $surface   $surface
client.urgent           $error    $error    $on_primary         $error     $error


# ─── Displays ───
output eDP-1 pos 0 0 mode 1920x1080@143.998Hz
output HDMI-A-1 pos 1920 0 mode 1920x1080@200.000Hz

# ─── Input Devices (Mouse & Touchpad) ───
input type:touchpad {
    tap enabled
    natural_scroll enabled
    pointer_accel 0.5
}

input type:pointer {
    pointer_accel 0.5
    # accel_profile flat
}

input type:keyboard {
    repeat_delay 250
    repeat_rate 50
}

floating_modifier $mod
mouse_warping container

# ─── Default Layout & Borders ───
workspace_layout tabbed
default_border pixel 0
default_floating_border normal 0
gaps inner 5

# ─── Window Rules ───
for_window [title="Picture in picture"] floating enable, sticky enable

# Key bindings
# ─── Applications ───
bindsym $mod+Return exec $term
bindsym $mod+v exec noctalia msg panel-toggle clipper
bindsym $mod+period exec noctalia msg panel-toggle launcher /emo
bindsym $mod+b exec sh -c $browser
bindsym $mod+Mod1+l exec noctalia msg session lock
bindsym $mod+Shift+q exec noctalia msg panel-toggle session
bindsym $mod+e exec $term -e yazi
bindsym $mod+d exec $menu
bindsym $mod+c exec $term -e nvim

# ─── Window Management ───
bindsym $mod+q kill

# ─── Focus ───
bindsym $mod+a focus parent
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# ─── Move Window ───
bindsym $mod+Ctrl+h move left
bindsym $mod+Ctrl+j move down
bindsym $mod+Ctrl+k move up
bindsym $mod+Ctrl+l move right
bindsym $mod+Ctrl+Left move left
bindsym $mod+Ctrl+Down move down
bindsym $mod+Ctrl+Up move up
bindsym $mod+Ctrl+Right move right

# ─── Workspaces ───
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+5 workspace number 5
bindsym $mod+6 workspace number 6
bindsym $mod+7 workspace number 7
bindsym $mod+8 workspace number 8
bindsym $mod+9 workspace number 9

bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4
bindsym $mod+Ctrl+5 move container to workspace number 5
bindsym $mod+Ctrl+6 move container to workspace number 6
bindsym $mod+Ctrl+7 move container to workspace number 7
bindsym $mod+Ctrl+8 move container to workspace number 8
bindsym $mod+Ctrl+9 move container to workspace number 9

# ─── Layout ───
bindsym $mod+backslash splith
bindsym $mod+minus splitv
bindsym $mod+w layout toggle tabbed split
bindsym $mod+f fullscreen
bindsym $mod+t floating toggle
bindsym $mod+space focus mode_toggle

# ─── Screenshots ───
bindsym Print exec noctalia msg screenshot-region
bindsym Ctrl+Print exec /home/hinne/.local/bin/screenshot-all
bindsym Mod1+Print exec noctalia msg screenshot-fullscreen pick
bindsym $mod+Print exec noctalia msg screenshot-region
bindsym $mod+Ctrl+Print exec /home/hinne/.local/bin/screenshot-all

# ─── Media & Brightness ───
bindsym XF86AudioRaiseVolume exec noctalia msg volume-up
bindsym XF86AudioLowerVolume exec noctalia msg volume-down
bindsym XF86AudioMute exec noctalia msg volume-mute
bindsym XF86AudioMicMute exec noctalia msg mic-mute
bindsym XF86AudioNext exec noctalia msg media next
bindsym XF86AudioPrev exec noctalia msg media previous
bindsym XF86AudioPlay exec noctalia msg media toggle
bindsym XF86AudioPause exec noctalia msg media toggle
bindsym XF86MonBrightnessUp exec noctalia msg brightness-up
bindsym XF86MonBrightnessDown exec noctalia msg brightness-down

# ─── Exit & Reload ───
bindsym $mod+Shift+c reload
bindsym Ctrl+Mod1+Delete exec swaymsg exit

# ─── Autostart ───
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME NIXOS_OZONE_WL
exec systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE QT_QPA_PLATFORMTHEME NIXOS_OZONE_WL
exec systemctl --user start sway-session.target
exec fcitx5 -d
exec sh -c 'sleep 3 && systemctl --user restart pipewire pipewire-pulse wireplumber'
exec sh -c 'sleep 1.5 && noctalia'
